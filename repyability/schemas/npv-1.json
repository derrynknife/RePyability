{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/derrynknife/RePyability/schemas/npv-1.json",
  "title": "RePyability value_plan, schema 1",
  "description": "A request to value a plan (value_plan) and its answer.",
  "$defs": {
    "diagram": {
      "description": "A RepairableRBD as its to_dict() saves it, or a UnitPlan as its to_dict() saves it (valued as its one-node diagram, UnitPlan.diagram()).",
      "type": "object"
    },
    "number": {
      "description": "A number; one that is not finite is written as text.",
      "oneOf": [
        {"type": "number"},
        {"enum": ["inf", "-inf", "nan"]}
      ]
    },
    "analysis": {
      "enum": [
        "expected_npv",
        "expected_npv_uncertainty",
        "npv_distribution",
        "compare_npv",
        "plan_vs_actual",
        "task_value"
      ]
    },
    "effect": {
      "description": "What a service does to the life (task_value): null for no effect (the default, the service an accepted cost), a Kijima restoration or virtual age, or a fitted condition (its life as a diagram saves a node's model).",
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "properties": {"kind": {"const": "none"}},
          "required": ["kind"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {"const": "restoration"},
            "q": {"type": "number", "minimum": 0},
            "model": {"enum": ["kijima1", "kijima2"]},
            "to_age": {"type": "number", "minimum": 0},
            "replace_every": {"type": "integer", "minimum": 1},
            "replacement_cost": {"type": "number"}
          },
          "required": ["kind"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {"const": "condition"},
            "life": {"type": "object", "required": ["kind"]},
            "fresh": {"type": "array", "items": {"type": "number"}},
            "stale": {"type": "array", "items": {"type": "number"}},
            "lasts": {"type": "number", "exclusiveMinimum": 0}
          },
          "required": ["kind", "life", "fresh", "stale", "lasts"],
          "additionalProperties": false
        }
      ]
    },
    "request": {
      "description": "A request; every analysis but task_value names a diagram (task_value's is the unit's plan, needed only with an effect).",
      "type": "object",
      "properties": {
        "schema": {"const": 1},
        "diagram": {"$ref": "#/$defs/diagram"},
        "analysis": {"$ref": "#/$defs/analysis"},
        "inputs": {
          "description": "The analysis's inputs, by its argument names.",
          "type": "object",
          "properties": {
            "horizon": {"type": "number", "exclusiveMinimum": 0},
            "discount_rate": {"type": "number"},
            "value_rate": {
              "oneOf": [
                {"type": "number"},
                {
                  "type": "object",
                  "properties": {
                    "times": {"type": "array", "items": {"type": "number"}},
                    "rates": {"type": "array", "items": {"type": "number"}}
                  },
                  "required": ["rates"],
                  "additionalProperties": false
                }
              ]
            },
            "periods": {
              "oneOf": [
                {"type": "integer", "minimum": 1},
                {"type": "array", "items": {"type": "number"}}
              ]
            },
            "escalation": {
              "description": "A diagram's growth rate by name; task_value's one yearly rate.",
              "oneOf": [
                {"type": "object", "additionalProperties": {"type": "number"}},
                {"type": ["number", "null"]}
              ]
            },
            "rates": {"enum": ["nominal", "real"]},
            "inflation": {"type": ["number", "null"]},
            "retire_at": {"type": ["number", "null"]},
            "salvage": {
              "oneOf": [
                {"type": "number"},
                {"type": "object", "additionalProperties": {"type": "number"}},
                {"type": "null"}
              ]
            },
            "state": {
              "type": "object",
              "additionalProperties": {"type": "object"}
            },
            "start_state": {
              "type": "object",
              "additionalProperties": {"type": "object"}
            },
            "timelines": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "required": ["end"]
              }
            },
            "seed": {"type": ["integer", "null"]},
            "mc_samples": {"type": ["integer", "null"], "minimum": 1},
            "task": {
              "description": "task_value: the task, a Task's to_dict().",
              "type": "object"
            },
            "usage": {
              "description": "task_value: the forecast's start and end, its duty plan (a DutyPlan's to_dict(); calendar time without one), readings and read_at, as a UsageForecast's to_dict() has them.",
              "type": "object",
              "required": ["start", "end"]
            },
            "effect": {"$ref": "#/$defs/effect"},
            "age": {"type": "number", "minimum": 0},
            "unit": {"type": ["string", "null"]},
            "discount": {"type": ["number", "null"]},
            "period": {"enum": ["day", "week", "month", "quarter", "year"]},
            "npv_tolerance": {"type": "number", "exclusiveMinimum": 0},
            "confidence": {
              "type": "number",
              "exclusiveMinimum": 0,
              "exclusiveMaximum": 1
            }
          }
        },
        "other": {"$ref": "#/$defs/diagram"}
      },
      "required": ["schema", "analysis"],
      "if": {"properties": {"analysis": {"not": {"const": "task_value"}}}},
      "then": {"required": ["diagram"]},
      "additionalProperties": false
    },
    "answer": {
      "type": "object",
      "properties": {
        "schema": {"const": 1},
        "analysis": {"$ref": "#/$defs/analysis"},
        "request": {"$ref": "#/$defs/request"},
        "units": {
          "type": "object",
          "properties": {
            "time": {"type": ["string", "null"]},
            "money": {"const": "cost units"}
          },
          "required": ["time", "money"]
        },
        "route": {
          "type": "object",
          "properties": {
            "route": {"enum": ["exact", "numerical", "simulated", "refused"]},
            "reason": {"type": "string"}
          },
          "required": ["route", "reason"]
        },
        "result": {
          "description": "The analysis's result, its to_dict().",
          "type": "object",
          "properties": {
            "npv": {"$ref": "#/$defs/number"},
            "mean": {"$ref": "#/$defs/number"}
          }
        },
        "refused": {
          "type": "object",
          "properties": {
            "reason": {"type": "string"},
            "routes": {
              "type": "object",
              "additionalProperties": {"type": "string"}
            }
          },
          "required": ["reason", "routes"]
        }
      },
      "required": ["schema", "analysis", "request", "units", "route"],
      "oneOf": [
        {"required": ["result"]},
        {"required": ["refused"]}
      ]
    }
  }
}
